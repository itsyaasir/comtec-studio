{
  "name": "comtec-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "node --experimental-strip-types --test tests/*.test.ts && cargo test --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write src tests index.html package.json tsconfig.json && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "bash scripts/package-macos.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "leaflet": "^1.9.4",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/leaflet": "^1.9.22",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
