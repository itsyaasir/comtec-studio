{
  "name": "comtec-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "node --experimental-strip-types --test tests/*.test.ts && cargo test --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write src tests index.html package.json tsconfig.json && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "bash scripts/package-macos.sh",
    "lint": "eslint src"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
